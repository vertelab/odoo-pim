<odoo>
    <record id="pim_change_confirm_wizard_view_form" model="ir.ui.view">
        <field name="name">pim.change.confirm.wizard.form</field>
        <field name="model">pim.change.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Overwrite">
                <field name="proposal_id" invisible="1" />
                <group>
                    <field name="message" nolabel="1" colspan="2" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Overwrite and approve"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
