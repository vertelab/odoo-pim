<odoo>
    <record id="group_pim_change_user" model="res.groups">
        <field name="name">PIM Change User</field>
        <field name="category_id" ref="pim_channel.module_category_pim_channel" />
        <field name="implied_ids" eval="[(4, ref('pim_channel.group_pim_channel_user'))]" />
        <field name="comment">Propose changes to product fields.</field>
    </record>

    <record id="group_pim_change_manager" model="res.groups">
        <field name="name">PIM Change Manager</field>
        <field name="category_id" ref="pim_channel.module_category_pim_channel" />
        <field name="implied_ids" eval="[(4, ref('group_pim_change_user')), (4, ref('pim_channel.group_pim_channel_manager'))]" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        <field name="comment">Define change policies and review groups.</field>
    </record>

    <record id="group_pim_change_reviewer" model="res.groups">
        <field name="name">PIM Change Reviewer</field>
        <field name="category_id" ref="pim_channel.module_category_pim_channel" />
        <field name="implied_ids" eval="[(4, ref('group_pim_change_user')), (4, ref('pim_channel.group_pim_channel_user'))]" />
        <field name="comment">Review proposals. Assign this group as a policy review group.</field>
    </record>
</odoo>
