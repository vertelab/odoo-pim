<odoo>
    <record id="product_template_form_view_pim_change" model="ir.ui.view">
        <field name="name">product.template.form.pim.change</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    string="Changes"
                    name="pim_changes"
                    groups="pim_change.group_pim_change_user"
                >
                    <group>
                        <group>
                            <field name="pim_pending_proposal_count" />
                            <field name="pim_pending_proposal_channel_count" />
                        </group>
                        <group>
                            <field name="pim_review_attribute_ids" widget="many2many_tags" />
                        </group>
                    </group>
                    <div class="text-muted">A field listed under Attributes Requiring Review must be proposed rather than written directly. Pending proposals are counted for this product, and separately for the selected channel.</div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
