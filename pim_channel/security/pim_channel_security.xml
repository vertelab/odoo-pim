<odoo>
    <record id="module_category_pim_channel" model="ir.module.category">
        <field name="name">PIM Channel</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_pim_channel_user" model="res.groups">
        <field name="name">PIM Channel User</field>
        <field name="category_id" ref="module_category_pim_channel" />
        <field name="comment">Enrich channel values, but not change scoping.</field>
    </record>

    <record id="group_pim_channel_manager" model="res.groups">
        <field name="name">PIM Channel Manager</field>
        <field name="category_id" ref="module_category_pim_channel" />
        <field name="implied_ids" eval="[(4, ref('group_pim_channel_user'))]" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        <field name="comment">Create channels and change attribute scoping.</field>
    </record>
</odoo>
