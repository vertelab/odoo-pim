<odoo>
    <record id="pim_completeness_rule_view_list" model="ir.ui.view">
        <field name="name">pim.completeness.rule.list</field>
        <field name="model">pim.completeness.rule</field>
        <field name="arch" type="xml">
            <list string="Completeness Rules">
                <field name="categ_id" />
                <field name="channel_id" />
                <field name="lang_id" />
                <field name="threshold" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="pim_completeness_rule_view_form" model="ir.ui.view">
        <field name="name">pim.completeness.rule.form</field>
        <field name="model">pim.completeness.rule</field>
        <field name="arch" type="xml">
            <form string="Completeness Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="categ_id" />
                            <field name="channel_id" />
                            <field name="lang_id" />
                        </group>
                        <group>
                            <field name="threshold" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Attributes" name="attributes">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="attribute_id" />
                                    <field name="weight" />
                                </list>
                            </field>
                            <div class="text-muted">Weight 0 excludes the attribute from both the numerator and the denominator.</div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pim_completeness_rule_view_search" model="ir.ui.view">
        <field name="name">pim.completeness.rule.search</field>
        <field name="model">pim.completeness.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="categ_id" />
                <field name="channel_id" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="pim_completeness_rule_action" model="ir.actions.act_window">
        <field name="name">Completeness Rules</field>
        <field name="res_model">pim.completeness.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="pim_completeness_rule_menu"
        name="Completeness Rules"
        parent="pim_channel.pim_channel_menu_config"
        action="pim_completeness_rule_action"
        sequence="30"
    />
</odoo>
